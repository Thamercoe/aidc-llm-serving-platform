# Copy this to .env (which compose reads automatically) and edit the values.
# .env is not committed; .env.example is the template that is.

# Docker Hub image to run.
IMAGE=thameralotaibi/aidc-serving:cpu-v2

# The model the service loads (small enough for CPU).
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Host port to publish the service on. The service listens on 8000 inside.
HOST_PORT=8000

# Bearer token the service requires on /v1/*. /health stays open so Kubernetes
# probes can reach it. Put a real value in .env (gitignored); this file is a template.
API_KEY=replace-me-with-something-random

# Hard ceiling on max_tokens per request. A caller can otherwise hold your GPU
# for as long as it likes; this caps the worst case one client can cost you.
MAX_TOKENS=256
